<?xml version="1.0"?><!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <!-- 检查报错信息使用中文 -->
    <property name='localeCountry' value='CN'/>
    <property name='localeLanguage' value='zh'/>

    <!-- 检查报错输出日志级别 -->
    <property name="severity" value="error"/>
    <!-- 源码文件编码 -->
    <property name="charset" value="UTF-8"/>
    <!-- 需要做检查的文件后缀 -->
    <property name="fileExtensions" value="java, properties, xml"/>
    <!-- 一旦遇到一个检查错误就停止执行后续检查-->
    <property name="haltOnException" value="false"/>

    <!-- ==================== Checks 级别模块 ==================== -->

    <!-- 报告重复的属性配置(.properties) -->
    <module name="UniqueProperties"/>
    <!-- 限制每个源码文件行数 -->
    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>
    <!-- 限制 Java 代码每行长度 -->
    <module name="LineLength">
        <property name="fileExtensions" value="java"/>
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>
    <!-- 限制不用 tab 缩进 -->
    <module name="FileTabCharacter"/>
    <!-- 检查 properties 文件的键是否有序（便于 diff 和查找），可能会影响同一类配置分组，禁用 -->
    <!-- <module name="OrderedProperties"/> -->
    <!-- 多语言 properties 文件的键值一致性检查 -->
    <module name="Translation"/>
    <!-- 文件末尾要有换行符（POSIX 规范） -->
    <module name="NewlineAtEndOfFile"/>
    <!-- 每个包应有 package-info.java 说明文档 -->
    <!-- 每个包应有 package-info.java — 与 Spotless Eclipse 格式化器冲突，禁用 -->
    <!-- <module name="JavadocPackage"/> -->

    <!-- ==================== Regexp 文件级检查 ==================== -->

    <!-- 正则表达式检查文件头是否存在 -->
    <!--<module name="RegexpHeader">
        <property name="header" value="^/\*\*$\n^ \* Copyright"/>
    </module>-->

    <!-- 根据 @SuppressWarnings 注解抑制检查报告（需与 TreeWalker 中的 SuppressWarningsHolder 配合使用） -->
    <module name="SuppressWarningsFilter"/>

    <module name="TreeWalker">

        <!-- tab 对应的空格数 -->
        <property name="tabWidth" value="4"/>

        <!-- ================================================================ -->
        <!--                     注解 Annotation                               -->
        <!-- ================================================================ -->

        <!-- 注解位置（声明注解不能与目标同行） -->
        <module name="AnnotationLocation">
            <property name="allowSamelineMultipleAnnotations" value="false"/>
            <property name="allowSamelineSingleParameterlessAnnotation" value="false"/>
            <property name="allowSamelineParameterizedAnnotation" value="false"/>
        </module>

        <!-- 注解使用风格（省略 value=、无参省略括号等） -->
        <module name="AnnotationUseStyle">
            <property name="elementStyle" value="compact_no_array"/>
            <property name="closingParens" value="never"/>
            <property name="trailingArrayComma" value="ignore"/>
        </module>

        <!-- javadoc 标注 @deprecated 的元素必需有 @Deprecated 注解；反之亦然 -->
        <module name="MissingDeprecated"/>
        <!-- javadoc 标注 @inheritDoc 的元素必需有 @Override 注解 -->
        <module name="MissingOverride"/>
        <!-- 支持使用 @SuppressWarnings 注解忽略 checkstyle 规则 -->
        <module name="SuppressWarningsHolder"/>
        <!-- 包级别注解必须在 package-info.java 中 -->
        <module name="PackageAnnotation"/>

        <!-- ================================================================ -->
        <!--                     语句块 Code Block                             -->
        <!-- ================================================================ -->

        <!-- 禁止裸露的嵌套代码块（无 if/for 等的纯 {} 块） -->
        <module name="AvoidNestedBlocks"/>
        <!-- 空 try 块必须有注释说明 -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_TRY"/>
        </module>
        <!-- 空 catch 块必须命名异常变量为 ignore 或写明注释 -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore"/>
            <property name="commentFormat" value="忽略异常"/>
        </module>
        <!-- 左大括号在行尾（K&R 风格） -->
        <module name="LeftCurly"/>
        <!-- 右大括号与 else/catch 同行，不另起一行 -->
        <module name="RightCurly"/>
        <!-- if/for/while/do 即使单行也必须使用大括号 -->
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="false"/>
            <property name="allowEmptyLoopBody" value="false"/>
        </module>

        <!-- ================================================================ -->
        <!--                     类 Class Design                              -->
        <!-- ================================================================ -->

        <!-- 内部类/接口必须放在类的最末尾（所有方法之后） -->
        <module name="InnerTypeLast"/>
        <!-- 接口不能只用来装常量（应定义类型行为） -->
        <module name="InterfaceIsType">
            <property name="allowMarkerInterfaces" value="true"/>
        </module>
        <!-- 一个源文件只能有一个顶级类 -->
        <module name="OneTopLevelClass"/>
        <!-- throws 声明的异常类型数量限制 -->
        <module name="ThrowsCount">
            <property name="max" value="4"/>
            <property name="ignorePrivateMethods" value="true"/>
        </module>
        <!-- 可见性修饰符使用规范 -->
        <module name="VisibilityModifier">
            <property name="packageAllowed" value="true"/>
            <property name="protectedAllowed" value="true"/>
            <property name="allowPublicFinalFields" value="true"/>
            <property name="allowPublicImmutableFields" value="true"/>
        </module>
        <!-- 可声明为 final 的类应显式标记 final -->
        <module name="FinalClass"/>
        <!-- 工具类（只有静态方法的类）应隐藏公有构造器 -->
        <!-- <module name="HideUtilityClassConstructor"/> -->
        <!-- 异常类应为不可变：字段都应是 final 的 -->
        <module name="MutableException"/>
        <!-- 类设计了 extends 能力时，应写 Javadoc 说明子类如何扩展 -->
        <module name="DesignForExtension"/>

        <!-- ================================================================ -->
        <!--                     编码 Coding                                 -->
        <!-- ================================================================ -->

        <!-- 禁止双大括号初始语句 new ArrayList<>() {{ add(x); }} -->
        <module name="AvoidDoubleBraceInitialization"/>
        <!-- 允许三元运算符 -->
        <!-- <module name="AvoidInlineConditionals"/> -->
        <!-- 无参 super() 调用可以省略，支持，显式声明 -->
        <!-- <module name="AvoidNoArgumentSuperConstructorCall"/> -->
        <!-- 禁止协变的 equals 方法，必须覆盖 Object.equals(Object) -->
        <module name="CovariantEquals"/>
        <!-- 类元素定义顺序：静态属性 → 实例属性 → 构造器 → 方法 → 内部类 -->
        <module name="DeclarationOrder"/>
        <!-- switch 中 default 必须放在最后 -->
        <module name="DefaultComesLast"/>
        <!-- 空语句（单独的分号） -->
        <module name="EmptyStatement"/>
        <!-- String 做 equals 比较时，字面量放在左边避免空指针 -->
        <module name="EqualsAvoidNull"/>
        <!-- String 必须用 equals() 做相等比较，不能用 == -->
        <module name="StringLiteralEquality"/>
        <!-- 同时覆盖 equals() 和 hashCode() -->
        <module name="EqualsHashCode"/>
        <!-- switch 无 break，必须用注释标明 fall through -->
        <module name="FallThrough"/>
        <!-- 局部变量不能和类字段同名 -->
        <module name="HiddenField">
            <property name="tokens" value="VARIABLE_DEF"/>
        </module>
        <!-- 方法签名不能 throws RuntimeException、Error 等 -->
        <module name="IllegalThrows"/>
        <!-- 禁止 catch 特定的宽泛异常类型（如 Exception、Throwable、Error），特定情况允许 -->
        <!-- <module name="IllegalCatch"/> -->
        <!-- 禁止使用特定类型 (可以配置 HashMap → Map 等) -->
        <module name="IllegalType">
            <property name="illegalClassNames"
                      value="java.util.GregorianCalendar, java.util.Hashtable, java.util.Vector, java.util.Stack"/>
        </module>
        <!-- 禁止八进制数字字面量 -->
        <module name="IllegalTokenText">
            <property name="tokens" value="NUM_INT,NUM_LONG"/>
            <property name="format" value="^0[^lx]"/>
            <property name="ignoreCase" value="true"/>
        </module>
        <!-- 禁止在非赋值表达式中做赋值操作 -->
        <module name="InnerAssignment"/>
        <!-- switch 必需有 default -->
        <module name="MissingSwitchDefault"/>
        <!-- 禁止在 for 循环体内修改循环变量 -->
        <module name="ModifiedControlVariable"/>
        <!-- 数组初始化要有尾逗号，git 变更更清晰 -->
        <module name="ArrayTrailingComma"/>
        <!-- 禁止在一行声明多个变量 -->
        <module name="MultipleVariableDeclarations"/>
        <!-- 限制 for/if/try 嵌套深度 -->
        <module name="NestedForDepth">
            <property name="max" value="3"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="3"/>
        </module>
        <!-- 禁用 clone 方法 -->
        <module name="NoClone"/>
        <!-- 禁用 finalize 方法 -->
        <module name="NoFinalizer"/>
        <!-- 每行只能有一条语句 -->
        <module name="OneStatementPerLine">
            <property name="treatTryResourcesAsStatement" value="true"/>
        </module>
        <!-- 重载方法应分组在一起 -->
        <module name="OverloadMethodsDeclarationOrder"/>
        <!-- 必需有包声明 -->
        <module name="PackageDeclaration"/>
        <!-- 禁止给方法参数赋值（确保参数不可变语义） -->
        <module name="ParameterAssignment"/>
        <!-- 简化布尔表达式 -->
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <!-- 多余的括号 -->
        <module name="UnnecessaryParentheses"/>
        <!-- 多余的分号 -->
        <module name="UnnecessarySemicolonAfterOuterTypeDeclaration"/>
        <module name="UnnecessarySemicolonAfterTypeMemberDeclaration"/>
        <module name="UnnecessarySemicolonInTryWithResources"/>
        <!-- 未使用的局部变量 -->
        <module name="UnusedLocalVariable"/>
        <!-- 变量定义与首次使用的距离 -->
        <module name="VariableDeclarationUsageDistance">
            <property name="allowedDistance" value="3"/>
            <property name="ignoreFinal" value="false"/>
            <property name="validateBetweenScopes" value="false"/>
        </module>

        <!-- ================================================================ -->
        <!--                     导入 Imports                                 -->
        <!-- ================================================================ -->

        <!-- 禁用 import * -->
        <module name="AvoidStarImport"/>
        <!-- 禁止导入特定包/模块 -->
        <module name="IllegalImport"/>
        <!-- import 顺序：标准 Java → 第三方 → 静态 import -->
        <module name="CustomImportOrder">
            <property name="customImportOrderRules"
                      value="STANDARD_JAVA_PACKAGE###THIRD_PARTY_PACKAGE###STATIC"/>
            <property name="thirdPartyPackageRegExp" value=".*"/>
            <property name="separateLineBetweenGroups" value="true"/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
        </module>
        <!-- 禁止重复 import -->
        <module name="RedundantImport"/>
        <!-- 禁止未使用的 import -->
        <module name="UnusedImports"/>

        <!-- ================================================================ -->
        <!--                     Javadoc 注释                                 -->
        <!-- ================================================================ -->

        <!-- 强制 Javadoc 标签顺序 -->
        <module name="AtclauseOrder"/>
        <!-- Javadoc 位置错误检测 -->
        <module name="InvalidJavadocPosition"/>
        <!-- Javadoc 块标签必须在行首 -->
        <module name="JavadocBlockTagLocation">
            <property name="tags" value="param, return, throws, since, see, deprecated"/>
        </module>
        <!-- Javadoc 内容位置（从第二行开始） -->
        <module name="JavadocContentLocationCheck">
            <property name="location" value="second_line"/>
        </module>
        <!-- 方法的 Javadoc 检查 -->
        <module name="JavadocMethod">
            <property name="allowMissingParamTags" value="true"/>
            <property name="allowMissingReturnTag" value="true"/>
            <property name="validateThrows" value="false"/>
        </module>
        <!-- Javadoc 每行必须 * 开头 -->
        <module name="JavadocMissingLeadingAsterisk"/>
        <!-- * 后必须有空格 -->
        <module name="JavadocMissingWhitespaceAfterAsterisk"/>
        <!-- 类的 Javadoc -->
        <module name="JavadocType">
            <property name="allowMissingParamTags" value="true"/>
        </module>
        <!-- Javadoc 段落应使用 <p> 标签 -->
        <!-- Javadoc 段落应使用 <p> 标签 — 与 Spotless Eclipse 格式化器冲突，禁用 -->
        <!-- <module name="JavadocParagraph"/> -->
        <!-- Javadoc 前导星号应对齐 -->
        <!-- Javadoc 前导星号应对齐 — 与 Spotless Eclipse 格式化器冲突，禁用 -->
        <!-- <module name="JavadocLeadingAsteriskAlign"/> -->
        <!-- 标签内容不能为空 -->
        <module name="NonEmptyAtclauseDescription"/>
        <!-- 有标签的 Javadoc 不能写成单行 -->
        <module name="SingleLineJavadoc"/>
        <!-- Javadoc 摘要不能为空 -->
        <module name="SummaryJavadocCheck">
            <property name="period" value=""/>
        </module>

        <!-- ================================================================ -->
        <!--                     代码复杂度 Metrics                            -->
        <!-- ================================================================ -->

        <!-- 布尔表达式复杂度（运算符数量） -->
        <module name="BooleanExpressionComplexity">
            <property name="max" value="5"/>
        </module>
        <!-- 非注释源码行数（方法/类/文件） -->
        <module name="JavaNCSS">
            <property name="methodMaximum" value="100"/>
            <property name="classMaximum" value="1500"/>
            <property name="fileMaximum" value="2000"/>
            <property name="recordMaximum" value="150"/>
        </module>
        <!-- 循环复杂度 -->
        <module name="CyclomaticComplexity">
            <property name="max" value="20"/>
        </module>
        <!-- NPath 复杂度 -->
        <module name="NPathComplexity">
            <property name="max" value="200"/>
        </module>
        <!-- 类的数据抽象耦合度 -->
        <module name="ClassDataAbstractionCoupling">
            <property name="max" value="7"/>
        </module>
        <!-- 类的扇出复杂度 -->
        <module name="ClassFanOutComplexity">
            <property name="max" value="20"/>
        </module>

        <!-- ================================================================ -->
        <!--                     杂项 Miscellaneous                           -->
        <!-- ================================================================ -->

        <!-- 强制 Java 风格数组 String[]（不是 String []） -->
        <module name="ArrayTypeStyle"/>
        <!-- 不要使用转义的 Unicode 字符（可读性） -->
        <module name="AvoidEscapedUnicodeCharacters">
            <property name="allowEscapesForControlCharacters" value="true"/>
        </module>
        <!-- 注释缩进应与代码一致 -->
        <module name="CommentsIndentation"/>
        <!-- 代码缩进 -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="caseIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
        </module>
        <!-- 文件必须有代码 -->
        <module name="NoCodeInFile"/>
        <!-- 类名必须与文件名一致 -->
        <module name="OuterTypeFilename"/>
        <!-- 禁止跟在代码后面的行尾注释 -->
        <module name="TrailingComment"/>
        <!-- long 字面量必须用大写 L -->
        <module name="UpperEll"/>

        <!-- ================================================================ -->
        <!--                     修饰符 Modifier                              -->
        <!-- ================================================================ -->

        <!-- 修饰符顺序符合 JLS 规范（public static final ...） -->
        <module name="ModifierOrder"/>
        <!-- 报告多余的修饰符 -->
        <module name="RedundantModifier"/>
        <!-- 嵌套类型的隐含修饰符必须显式写出 -->
        <module name="ClassMemberImpliedModifier"/>

        <!-- ================================================================ -->
        <!--                     命名规则 Naming                              -->
        <!-- ================================================================ -->

        <!-- 标识符中连续大写字母不超过 1 个（驼峰命名） -->
        <module name="AbbreviationAsWordInName">
            <property name="allowedAbbreviationLength" value="1"/>
            <property name="ignoreStatic" value="false"/>
            <property name="ignoreFinal" value="false"/>
        </module>
        <!-- 抽象类命名以 Abstract 开头 -->
        <module name="AbstractClassName"/>
        <!-- 捕获的异常变量命名 -->
        <module name="CatchParameterName">
            <property name="format" value="^(e|t|ex|[a-z][a-zA-Z0-9]+)$"/>
        </module>
        <!-- 泛型类型参数命名（单个大写字母） -->
        <module name="ClassTypeParameterName">
            <property name="format" value="^[A-Z]{1,}$"/>
        </module>
        <module name="InterfaceTypeParameterName">
            <property name="format" value="^[A-Z]{1,}$"/>
        </module>
        <module name="MethodTypeParameterName">
            <property name="format" value="^[A-Z]{1,}$"/>
        </module>
        <module name="RecordTypeParameterName">
            <property name="format" value="^[A-Z]{1,}$"/>
        </module>
        <!-- 常量命名全大写 -->
        <module name="ConstantName"/>
        <!-- lambda 参数命名 -->
        <module name="LambdaParameterName"/>
        <!-- 局部变量命名 -->
        <module name="LocalFinalVariableName"/>
        <module name="LocalVariableName">
            <property name="allowOneCharVarInForLoop" value="true"/>
        </module>
        <!-- 成员字段命名 -->
        <module name="MemberName"/>
        <!-- 方法命名 -->
        <module name="MethodName"/>
        <!-- 包命名全小写 -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <!-- 参数命名 -->
        <module name="ParameterName"/>
        <!-- 静态字段命名 -->
        <module name="StaticVariableName"/>
        <!-- 类命名大写开头 -->
        <module name="TypeName"/>
        <!-- record 组件命名（小写开头） -->
        <module name="RecordComponentName"/>
        <!-- 模式变量命名（小写开头） -->
        <module name="PatternVariableName"/>
        <!-- 非法标识符名检测（阻止使用保留字或特定名称） -->
        <module name="IllegalIdentifierName"/>

        <!-- ================================================================ -->
        <!--                     代码长度/数量 Size                           -->
        <!-- ================================================================ -->

        <!-- 匿名内部类最大行数 -->
        <module name="AnonInnerLength">
            <property name="max" value="20"/>
        </module>
        <!-- 每个方法中最大语句数 -->
        <module name="ExecutableStatementCount">
            <property name="max" value="60"/>
        </module>
        <!-- Lambda 表达式最大行数 -->
        <module name="LambdaBodyLength">
            <property name="max" value="30"/>
        </module>
        <!-- 类定义的方法数量 -->
        <module name="MethodCount">
            <property name="maxTotal" value="100"/>
            <property name="maxPublic" value="100"/>
        </module>
        <!-- 每个方法最大行数 -->
        <module name="MethodLength">
            <property name="max" value="200"/>
        </module>
        <!-- 文件中外层类型数量 -->
        <module name="OuterTypeNumber"/>
        <!-- 每个方法最大参数数量 -->
        <module name="ParameterNumber">
            <property name="max" value="7"/>
            <property name="tokens" value="METHOD_DEF"/>
            <property name="ignoreOverriddenMethods" value="true"/>
        </module>
        <!-- record 组件最大数量 -->
        <module name="RecordComponentNumber">
            <property name="max" value="8"/>
        </module>

        <!-- ================================================================ -->
        <!--                     空格 Whitespace                              -->
        <!-- ================================================================ -->

        <!-- for 空表达式的空格策略 -->
        <module name="EmptyForInitializerPad">
            <property name="option" value="nospace"/>
        </module>
        <module name="EmptyForIteratorPad">
            <property name="option" value="nospace"/>
        </module>
        <!-- 类成员之间必须有空行分隔 -->
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
            <property name="allowMultipleEmptyLines" value="false"/>
            <property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/>
        </module>
        <!-- 泛型尖括号前后空格 -->
        <module name="GenericWhitespace"/>
        <!-- 方法参数括号前后空格 -->
        <module name="MethodParamPad"/>
        <!-- package/import 语句不能断行 -->
        <module name="NoLineWrap"/>
        <!-- 某些 token 后不能有空格 / 前不能有空格 -->
        <module name="NoWhitespaceAfter"/>
        <module name="NoWhitespaceBefore">
            <property name="allowLineBreaks" value="true"/>
        </module>
        <!-- switch 冒号前不能有空格 -->
        <module name="NoWhitespaceBeforeCaseDefaultColon"/>
        <!-- 特定 token 后必须跟空格 -->
        <module name="WhitespaceAfter">
            <property name="tokens"
                      value="COMMA, SEMI, LITERAL_IF, LITERAL_ELSE, LITERAL_WHILE, LITERAL_DO, LITERAL_FOR, DO_WHILE"/>
        </module>
        <!-- token 两侧必须有空格 -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="false"/>
            <property name="allowEmptyLambdas" value="false"/>
            <property name="allowEmptyCatches" value="false"/>
        </module>
        <!-- 操作符断行策略 -->
        <module name="OperatorWrap"/>
        <!-- 括号内空格策略 -->
        <module name="ParenPad"/>
        <!-- 非空白字符之间最多一个空格 -->
        <module name="SingleSpaceSeparator"/>
        <!-- 强制类型转换括号空格 -->
        <module name="TypecastParenPad"/>

        <!-- ================================================================ -->
        <!--                     Regexp 检查                                   -->
        <!-- ================================================================ -->

        <!-- 文件内禁止出现特定模式（如 System.out.println） -->
        <!-- <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="message" value="禁止使用 System.out/err，应使用日志框架"/>
            <property name="ignoreCase" value="true"/>
        </module> -->

    </module>
</module>
